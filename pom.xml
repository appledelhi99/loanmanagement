<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent and aggregator for the Loan Management Platform.
        - Inherits Spring Boot's parent for plugin defaults (compiler, Surefire, Failsafe, resources, repackage).
        - Imports the Spring Cloud release-train BOM, so no Spring Cloud module carries its own version.
        - Child modules declare dependencies WITHOUT versions; this file is the single place to upgrade.
        Versions verified in docs/architecture/05-version-compatibility-matrix.md (ADR-0001).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.loanplatform</groupId>
    <artifactId>loan-management-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Loan Management Platform</name>
    <description>Spring Boot microservices portfolio project: loans, simulated payments, notifications.</description>

    <modules>
        <module>services/config-server</module>
        <module>services/discovery-server</module>
    </modules>

    <properties>
        <!-- Read by spring-boot-starter-parent to set maven.compiler.release. -->
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <!-- 0.8.14 is the first JaCoCo release with official Java 25 support. -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- Build environment and dependencies that must never appear, not even transitively. -->
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Build with JDK 25 (Eclipse Temurin 25). See ADR-0001.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Use Maven 3.9 or newer; ./mvnw downloads the pinned version.</message>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.projectlombok:lombok</exclude>
                                        <exclude>junit:junit</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-openfeign-core</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-sleuth</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-sleuth-api</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-sleuth-core</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-sleuth-autoconfigure</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-sleuth-instrumentation</exclude>
                                    </excludes>
                                    <message>Banned dependency. Lombok and JUnit 4 are not used; OpenFeign is replaced by Spring HTTP Service Clients (ADR-0005); Sleuth is replaced by Micrometer Tracing (ADR-0016).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <!-- Dependencies our own POMs must not declare. Checked on direct declarations only,
                         because framework modules may still reference them internally. -->
                    <execution>
                        <id>enforce-no-legacy-declarations</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.retry:*</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-web-services</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-aop</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-resource-server</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-client</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-authorization-server</exclude>
                                    </excludes>
                                    <message>Do not declare Spring Retry (archived; use Spring Framework retry, ADR-0014/0017) or Boot 3 starter names (use the Boot 4 names, e.g. spring-boot-starter-webmvc).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Integration tests (*IT) run in the integration-test phase; executions are preconfigured by the Boot parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
